# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/yantrodharaka

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Initial Admin (used only on first startup) ─────────────────────────────
ADMIN_EMAIL=admin@yantrodharaka.in
ADMIN_PASSWORD=ChangeMe@2025!

# ── Storage (S3-compatible; leave empty to use local uploads/) ─────────────
STORAGE_BACKEND=local
